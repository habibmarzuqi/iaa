// IAA Digital Schema (updated)
// IAA Digital - Ikatan Arsiparis ANRI
// Prisma schema for organization management platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ AUTH & USERS ============

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          Role     @default(ANGGOTA)
  avatar        String?
  isActive      Boolean  @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member        Member?
  articles      Article[]
  events        Event[]      @relation("EventOrganizer")
  certificates  Certificate[] // certificates issued BY this user
  auditLogs     AuditLog[]
  archivesUploaded      Archive[]      @relation("ArchiveUploader")
  archiveVersions       ArchiveVersion[] @relation("ArchiveVersionUploader")
  groupMemberships      UserGroupMembership[]
  archiveAccesses       ArchiveAccess[]   @relation("ArchiveAccessUser")
  chatConversations     ChatConversation[] @relation("ChatConversationUser")
  notifications         Notification[]   @relation("NotificationUser")
  oauthAccounts         OAuthAccount[]   @relation("OAuthAccountUser")
  backupsTriggered      BackupHistory[]  @relation("BackupTriggeredBy")
  articleRevisions      ArticleRevision[] @relation("ArticleRevisionEditor")
  mediaAssetsUploaded   MediaAsset[]     @relation("MediaAssetUploader")
  siteSettingsUpdated   SiteSetting[]    @relation("SiteSettingUpdater")

  @@index([role])
}

enum Role {
  SUPER_ADMIN
  ADMINISTRATOR
  PENGURUS
  ANGGOTA
}

// ============ MEMBERS ============

model Member {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberNumber    String   @unique
  nip             String?
  fullName        String
  photo           String?
  workUnit        String?
  position        String?
  arsiparisLevel  ArsiparisLevel?
  education       String?
  trainingHistory String?  @db.Text // JSON string of training records
  certificationHistory String? @db.Text // JSON string
  status          MemberStatus @default(AKTIF)
  joinDate        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  registrations   Registration[]
  certificates    Certificate[]

  @@index([status])
  @@index([arsiparisLevel])
}

enum ArsiparisLevel {
  PEMULA
  MUDA
  MADYA
  UTAMA
}

enum MemberStatus {
  AKTIF
  TIDAK_AKTIF
  PENSIUN
  MENINGGAL
  PENDING
}

// ============ ARTICLES / BERITA ============

model Article {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  excerpt       String   @db.Text
  content       String   @db.LongText
  featuredImage String?
  category      String   @default("Umum")
  tags          String?  // comma-separated
  isFeatured    Boolean  @default(false)
  isPublished   Boolean  @default(true)
  publishStatus PublishStatus @default(PUBLISHED)
  scheduledAt   DateTime?   // when to auto-publish (if SCHEDULED)
  publishedAt   DateTime @default(now())
  viewCount     Int      @default(0)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id])
  // SEO metadata (Phase 4)
  metaDescription String?  @db.Text // custom meta description (default: excerpt)
  ogTitle         String?  // custom OpenGraph title (default: title)
  ogImage         String?  // custom OG image URL (default: featuredImage)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  revisions    ArticleRevision[]

  @@index([isPublished, publishedAt])
  @@index([category])
  @@index([publishStatus])
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ArticleRevision {
  id          String   @id @default(cuid())
  articleId   String
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  excerpt     String   @db.Text
  content     String   @db.LongText
  editedById  String
  editedBy    User     @relation("ArticleRevisionEditor", fields: [editedById], references: [id])
  changeLog   String?  // optional note about what changed
  createdAt   DateTime @default(now())

  @@unique([articleId, version])
  @@index([articleId])
}

// ============ MEDIA LIBRARY (Phase 4) ============

model MediaAsset {
  id          String   @id @default(cuid())
  filename    String   // original filename
  storedName  String   // unique stored filename
  url         String   // public URL (/uploads/xxx)
  mimeType    String
  size        Int      // bytes
  width       Int?
  height      Int?
  alt         String?  // alt text
  caption     String?
  // Image optimization variants (Phase 4 enrichment)
  thumbUrl    String?  // 200x200 thumbnail
  mediumUrl   String?  // 800px width medium
  largeUrl    String?  // 1200px width large
  uploadedById String
  uploadedBy  User     @relation("MediaAssetUploader", fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())

  @@index([uploadedById])
  @@index([mimeType])
}

// ============ EVENTS ============

model Event {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String   @db.Text
  eventType     EventType
  coverImage    String?
  location      String
  startDate     DateTime
  endDate       DateTime
  quota         Int      @default(100)
  registeredCount Int    @default(0)
  isPublished   Boolean  @default(true)
  isRegistrationOpen Boolean @default(true)
  isPublicEvent Boolean  @default(false)// true = buka untuk umum
  organizerId   String
  organizer     User     @relation("EventOrganizer", fields: [organizerId], references: [id])
  certificateTemplateId String?
  certificateTemplate   CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  registrations Registration[]
  certificates  Certificate[]

  @@index([startDate])
  @@index([eventType])
}

enum EventType {
  SEMINAR
  WORKSHOP
  WEBINAR
  RAPAT
  PELATIHAN
  LOMBA
}

// ============ REGISTRATIONS ============

model Registration {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  isMember    Boolean  @default(true)
  participantName        String?
  participantEmail       String?
  participantPhone       String?
  participantInstitution String?
  status      RegistrationStatus @default(PENDING)
  checkedIn   Boolean  @default(false)
  checkedInAt DateTime?
  registeredAt DateTime @default(now())

  @@index([status])
  @@index([memberId])
  @@index([participantEmail])
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  WAITING_LIST
  CANCELLED
}

// ============ CERTIFICATES ============

model Certificate {
  id              String   @id @default(cuid())
  certificateNumber String @unique
  eventId         String?
  event           Event?   @relation(fields: [eventId], references: [id])
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  participantName        String?
  participantEmail       String?
  participantInstitution String?
  registrationId  String?
  issuedById      String
  issuedBy        User     @relation(fields: [issuedById], references: [id])
  title           String
  description     String?
  template        String   @default("default")
  issuedAt        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([memberId])
  @@index([eventId])
  @@index([participantEmail])
}

// ============ DIGITAL LIBRARY ============

model LibraryItem {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String   @db.Text
  category      LibraryCategory
  author        String?
  publisher     String?
  year          Int?
  coverImage    String?
  fileUrl       String?
  fileSize      Int?
  pages         Int?
  tags          String?
  downloadCount Int      @default(0)
  viewCount     Int      @default(0)
  isPublished   Boolean  @default(true)
  accessLevel   AccessLevel @default(PUBLIK)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([accessLevel])
}

enum LibraryCategory {
  BUKU
  EBOOK
  JURNAL
  PEDOMAN
  REGULASI
  SOP
  TEMPLATE
  PRESENTASI
  MAJALAH
  VIDEO
  AUDIO
}

// ============ GALLERY ============

model GalleryAlbum {
  id          String   @id @default(cuid())
  title       String
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos      GalleryPhoto[]
}

model GalleryPhoto {
  id          String   @id @default(cuid())
  albumId     String
  album       GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title       String?
  url         String
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([albumId])
  @@index([albumId, order])
}

// ============ ANNOUNCEMENTS ============

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  type        AnnouncementType @default(BANNER)
  isPinned    Boolean  @default(false)
  isPopup     Boolean  @default(false)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum AnnouncementType {
  BANNER
  POPUP
  RUNNING_TEXT
  PINNED
}

// ============ ORGANIZATION STRUCTURE & CATEGORIES ============

model OrgCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]

  @@index([order])
}

model OrganizationMember {
  id          String   @id @default(cuid())
  name        String
  position    String
  photo       String?
  bio         String?
  order       Int      @default(0)
  category    String   @default("Pengurus Pusat")
  categoryId  String?
  categoryRef OrgCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isActive])
}

// ============ FAQ ============

model FAQItem {
  id          String   @id @default(cuid())
  question    String   @db.Text
  answer      String   @db.Text
  category    String   @default("Umum")
  order       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublished])
}

// ============ AUDIT LOG ============

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============ CONTACT MESSAGES ============

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  subject     String
  message     String   @db.Text
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isRead])
}

// ============ ORGANIZATION ARCHIVE (Modul Arsip Digital Organisasi) ============

model Archive {
  id              String   @id @default(cuid())
  archiveNumber   String   @unique             // e.g. "ARC-SK-2026-001"
  title           String
  description     String?  @db.Text
  category        ArchiveCategory
  documentDate    DateTime                     // tanggal dokumen asli
  source          String?                      // asal dokumen / pihak pengirim
  destination     String?                      // tujuan dokumen (untuk surat keluar)
  classification  Classification @default(PUBLIK)
  accessLevel     AccessLevel    @default(PUBLIK)
  tags            String?                      // comma-separated
  currentVersion  Int            @default(1)
  isPinned        Boolean        @default(false)
  uploadedById    String
  uploadedBy      User           @relation("ArchiveUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  versions        ArchiveVersion[]
  accesses        ArchiveAccess[]

  @@index([category])
  @@index([classification])
  @@index([accessLevel])
  @@index([documentDate])
}

enum ArchiveCategory {
  SURAT_MASUK
  SURAT_KELUAR
  DOKUMEN_RAPAT
  SK
  AD_ART
  MOU
  DOKUMEN_ORGANISASI
  FOTO
  VIDEO
}

enum Classification {
  PUBLIK
  INTERNAL
  RAHASIA
  SANGAT_RAHASIA
}

enum AccessLevel {
  PUBLIK          // semua orang bisa lihat
  ANGGOTA         // login sebagai anggota
  PENGURUS        // pengurus+
  ADMIN           // administrator+
  SUPER_ADMIN     // super admin only
}

model ArchiveVersion {
  id            String   @id @default(cuid())
  archiveId     String
  archive       Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  version       Int
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  changeLog     String?
  uploadedById  String
  uploadedBy    User     @relation("ArchiveVersionUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([archiveId, version])
  @@index([archiveId])
}

model ArchiveAccess {
  id          String   @id @default(cuid())
  archiveId   String
  archive     Archive  @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation("ArchiveAccessUser", fields: [userId], references: [id])
  action      String   // VIEW, DOWNLOAD, UPLOAD, EDIT, DELETE
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([archiveId])
  @@index([userId])
}

// ============ AI CHAT CONVERSATIONS ============

model ChatConversation {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation("ChatConversationUser", fields: [userId], references: [id])
  guestName   String?
  title       String   @default("Percakapan Baru")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id            String   @id @default(cuid())
  conversationId String
  conversation  ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role          String   // "user" | "assistant"
  content       String   @db.Text
  createdAt     DateTime @default(now())

  @@index([conversationId])
}

// ============ NOTIFICATIONS (Phase 3) ============

model Notification {
  id          String   @id @default(cuid())
  userId      String?                      // null = broadcast ke semua user
  user        User?    @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String   @db.Text
  link        String?                      // optional route/URL
  data        String?  @db.Text                    // JSON string for additional data
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

enum NotificationType {
  SYSTEM
  EVENT_REMINDER
  REGISTRATION_STATUS
  CERTIFICATE_ISSUED
  ANNOUNCEMENT
  MESSAGE
}

// ============ OAUTH ACCOUNTS (Phase 3) ============

model OAuthAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("OAuthAccountUser", fields: [userId], references: [id], onDelete: Cascade)
  provider      String                       // "google" | "microsoft" | "facebook"
  providerAccountId String                   // unique ID from provider
  email         String?
  name          String?
  avatar        String?
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============ BACKUP HISTORY (Phase 3) ============

model BackupHistory {
  id          String   @id @default(cuid())
  type        String                       // "manual" | "scheduled"
  status      String                       // "success" | "failed" | "in_progress"
  fileName    String
  fileSize    Int?
  recordCount Int?
  triggeredById String?
  triggeredBy User?    @relation("BackupTriggeredBy", fields: [triggeredById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// ============ SITE SETTINGS (Phase: Public Website Config) ============

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String?  @db.Text
  type        String   @default("text")
  category    String   @default("general")
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SiteSettingUpdater", fields: [updatedById], references: [id])
}

// ============ MENU MANAGEMENT ============

model MenuConfig {
  id          String   @id @default(cuid())
  label       String
  labelKey    String?
  view        String?
  url         String?
  icon        String?
  parentId    String?
  parent      MenuConfig? @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuConfig[] @relation("MenuChildren")
  order       Int      @default(0)
  isVisible   Boolean  @default(true)
  isExternal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([order])
  @@index([isVisible])
}

// ============ CERTIFICATE TEMPLATES ============

model CertificateTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?     // background template image
  fileUrl      String?     // downloadable template file (PDF/PNG)
  layoutConfig String?  @db.Text // JSON string containing X, Y coordinates, font sizes, alignment
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]
}



// ============ USER GROUPS & PERMISSIONS ============

model UserGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("blue")  // badge color: blue, emerald, gold, purple, orange, rose
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserGroupMembership[]
  permissions GroupPermission[]

  @@index([isActive])
}

model UserGroupMembership {
  id        String   @id @default(cuid())
  userId    String
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

model GroupPermission {
  id        String   @id @default(cuid())
  groupId   String
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  module    String   // e.g. "admin-events", "admin-members", "admin-cms"
  canView   Boolean  @default(true)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, module])
  @@index([groupId])
}


